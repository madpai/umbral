[navigation]

; Must match the NavigationMesh in main.tscn or the map rasterises the baked
; mesh at a different resolution and warns about edge errors.
3d/default_cell_size=0.25
3d/default_cell_height=0.05

[physics]

; The character moves at 60 Hz but renders at display rate. Without this, the
; mesh holds still for 1-2 render frames and then jumps, which reads as shake.
; Measured before enabling: 59% of render frames showed zero character movement.
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
